{
  "name": "lifeos",
  "private": true,
  "version": "1.5.1",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "description": "A personal life management system for tracking habits, goals, projects, and long-term personal growth.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "pnpm --filter @lifeos/api lint && pnpm --filter @lifeos/web lint && pnpm --filter @lifeos/shared lint",
    "typecheck": "pnpm --filter @lifeos/api typecheck && pnpm --filter @lifeos/web typecheck",
    "test": "pnpm --filter @lifeos/api test && pnpm --filter @lifeos/web test",
    "test:coverage": "pnpm --filter @lifeos/api test:coverage && pnpm --filter @lifeos/web test:coverage",
    "audit": "pnpm audit --prod",
    "build": "pnpm --filter @lifeos/api build && pnpm --filter @lifeos/web build",
    "prisma:generate": "pnpm --filter @lifeos/api exec prisma generate",
    "db:migrate": "pnpm --filter @lifeos/api exec prisma migrate deploy"
  },
  "keywords": [
    "node",
    "typescript",
    "fastify",
    "habits"
  ],
  "author": {
    "name": "Victor Vasconcelos",
    "email": "vvasconcelos.dev@gmail.com",
    "url": "https://github.com/vvasconceloss"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.13.3"
  }
}

Copy this file to `.env` and fill in real values. Never commit `.env`.

```bash
# Environment (development | production). Controls cookie security.
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=3000

# Comma-separated list of allowed CORS origins (no wildcard allowed).
# Production example: https://lifeos.app,https://www.lifeos.app
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL connection string (managed DB recommended in production).
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos"

# JWT signing secret — use a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me

# Structured log level (trace | debug | info | warn | error).
LOG_LEVEL=info

# Rate limiting (global).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Stricter limits on auth endpoints.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW=1 minute
DEMO_RATE_LIMIT_MAX=10
DEMO_RATE_LIMIT_WINDOW=1 minute

# Email verification resend limit (per email/IP).
RESEND_VERIFICATION_RATE_LIMIT_MAX=3
RESEND_VERIFICATION_RATE_LIMIT_WINDOW=1 hour

# Password recovery limits.
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW=1 hour
RESET_PASSWORD_RATE_LIMIT_MAX=10
RESET_PASSWORD_RATE_LIMIT_WINDOW=1 hour

# Web app origin used to build verification/reset links in emails.
# In production this MUST be the public origin (email clients cannot reach localhost).
WEB_URL=https://lifeos.app

# Transactional email (Gmail SMTP). EMAIL_ENABLED=false (default) = dry-run: emails
# are rendered and logged but never sent — safe for local development and CI.
# Enable it only when EMAIL_USER/EMAIL_PASS hold a real Gmail app password.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreplylifeos.focus@gmail.com
EMAIL_PASS=change-me
EMAIL_FROM_NAME=LifeOS
EMAIL_FROM_ADDRESS=noreplylifeos.focus@gmail.com
EMAIL_REPLY_TO=noreplylifeos.focus+support@gmail.com

# Alternative transport: Gmail REST API over HTTPS (no SMTP ports needed).
# Use this on hosts whose SMTP egress is blocked (e.g. free Render). Requires a
# Google Cloud OAuth2 client + refresh token (scope: https://mail.google.com/).
# Set EMAIL_PROVIDER=gmail-api and fill the GOOGLE_OAUTH_* values.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_OAUTH_USER=noreplylifeos.focus@gmail.com
```

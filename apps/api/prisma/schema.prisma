generator client {
  provider = "prisma-client"
  output   = "../src/generated/"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  timezone     String?
  weekStart    Int      @default(1)
  theme        String   @default("system")
  onboarded    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pillars   Pillar[]
  habits    Habit[]
  goals     Goal[]
  projects  Project[]
  dailyLogs DailyLog[]
}

model Pillar {
  id          String   @id @default(uuid())
  name        String
  color       String?
  icon        String?
  description String?
  sortOrder   Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]
  goals  Goal[]
  projects Project[]

  @@index([userId])
}

model Habit {
  id            String         @id @default(uuid())
  name          String
  description   String?
  userId        String
  pillarId      String
  frequency     HabitFrequency @default(DAILY)
  daysOfWeek    Int[]          @default([])
  timesPerWeek  Int?
  timesPerMonth Int?
  icon          String?
  color         String?
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillar      Pillar            @relation(fields: [pillarId], references: [id], onDelete: Restrict)
  completions HabitCompletion[]
  goalHabits  GoalHabit[]

  @@index([userId])
  @@index([pillarId])
}

enum HabitFrequency {
  DAILY
  WEEKLY_DAYS
  TIMES_PER_WEEK
  TIMES_PER_MONTH
}

model Goal {
  id          String     @id @default(uuid())
  title       String
  description String?
  userId      String
  pillarId    String
  status      GoalStatus @default(ACTIVE)
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillar Pillar      @relation(fields: [pillarId], references: [id], onDelete: Restrict)
  habits GoalHabit[]

  @@index([userId])
  @@index([pillarId])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model GoalHabit {
  goalId    String
  habitId   String
  createdAt DateTime @default(now())

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([goalId, habitId])
}

model DailyLog {
  id         String   @id @default(uuid())
  userId     String
  date       DateTime
  mood       Int?
  energy     Int?
  sleepHours Float?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model HabitCompletion {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  PAUSED
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  pillarId    String
  title       String
  description String?
  status      ProjectStatus @default(PLANNING)
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillar Pillar        @relation(fields: [pillarId], references: [id], onDelete: Restrict)
  tasks  ProjectTask[]

  @@index([userId])
  @@index([pillarId])
}

model ProjectTask {
  id        String   @id @default(uuid())
  projectId String
  title     String
  isDone    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

{
  "name": "@lifeos/api",
  "private": true,
  "version": "1.5.1",
  "description": "Backend API for LifeOS, a personal life management system for tracking habits, goals, projects, and long-term personal growth.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/lib",
    "test:integration": "vitest run src/modules src/plugins src/app.test.ts",
    "test:e2e": "vitest run src/e2e.test.ts src/failure-scenarios.test.ts",
    "audit": "pnpm audit --prod",
    "lint": "eslint .",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "jobs:process-account-deletions": "tsx src/scripts/process-account-deletions.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev"
  },
  "keywords": [
    "node",
    "typescript",
    "fastify",
    "habits"
  ],
  "author": {
    "name": "Victor Vasconcelos",
    "email": "vvasconcelos.dev@gmail.com",
    "url": "https://github.com/vvasconceloss"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@lifeos/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "i18next": "^26.3.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prisma": "^7.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}

{
  "name": "@lifeos/web",
  "private": true,
  "version": "1.6.1",
  "description": "Web application for LifeOS, a personal life management system for tracking habits, goals, projects, and long-term personal growth.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "i18n:check:orphans": "node scripts/check-i18n-keys.mjs --check-orphans",
    "audit": "pnpm audit --prod"
  },
  "keywords": [
    "react",
    "typescript",
    "tailwindcss",
    "habits"
  ],
  "author": {
    "name": "Victor Vasconcelos",
    "email": "vvasconcelos.dev@gmail.com",
    "url": "https://github.com/vvasconceloss"
  },
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lifeos/shared": "workspace:*",
    "@sentry/react": "^9.47.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.27.0",
    "motion": "^13.0.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.5",
    "shadcn": "^4.16.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
